POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=mergen
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-secret-manager-value
POSTGRES_PORT=55432
MERGEN_MIGRATION_PASSWORD=replace-migration-password
MERGEN_APPLICATION_PASSWORD=replace-application-password
MERGEN_RELAY_PASSWORD=replace-relay-password
MERGEN_EXAMPLE_MIGRATION_DATABASE_URL=postgresql+asyncpg://mergen_migration:replace-migration-password@127.0.0.1:55432/mergen
MERGEN_EXAMPLE_DATABASE_URL=postgresql+asyncpg://mergen_app:replace-application-password@127.0.0.1:55432/mergen
MERGEN_EXAMPLE_RELAY_DATABASE_URL=postgresql+asyncpg://mergen_relay:replace-relay-password@127.0.0.1:55432/mergen
