POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=fastapi_effects
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-secret-manager-value
POSTGRES_PORT=55432
FASTAPI_EFFECTS_MIGRATION_PASSWORD=replace-migration-password
FASTAPI_EFFECTS_APPLICATION_PASSWORD=replace-application-password
FASTAPI_EFFECTS_RELAY_PASSWORD=replace-relay-password
FASTAPI_EFFECTS_EXAMPLE_MIGRATION_DATABASE_URL=postgresql+asyncpg://fastapi_effects_migration:replace-migration-password@127.0.0.1:55432/fastapi_effects
FASTAPI_EFFECTS_EXAMPLE_DATABASE_URL=postgresql+asyncpg://fastapi_effects_app:replace-application-password@127.0.0.1:55432/fastapi_effects
FASTAPI_EFFECTS_EXAMPLE_RELAY_DATABASE_URL=postgresql+asyncpg://fastapi_effects_relay:replace-relay-password@127.0.0.1:55432/fastapi_effects
